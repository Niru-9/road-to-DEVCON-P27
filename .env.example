# Copy to .env and fill in. NEVER commit a real .env file.
# Backend selection: mock (default, offline, deterministic) | sarvam | llm
BHASHA_BACKEND=mock

# Sarvam Translate API - https://docs.sarvam.ai/api-reference-docs/
SARVAM_API_KEY=

# Any OpenAI-compatible chat completions endpoint
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
